# UPSTASH REDIS CREDENTIALS
# Create a free database at https://console.upstash.com
# Copy the REST URL and REST Token from the database details page.
UPSTASH_REDIS_REST_URL="https://your-upstash-db.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token_here"

# ADMINISTRATOR SECURITY CONFIGURATION
# Generate a PBKDF2 hash using: node scripts/generate_admin_hash.js "YourStrongPassword"
ADMIN_PASSWORD_HASH="pbkdf2:100000:random_salt_hex:computed_hash_hex"

# Random secret (32+ characters) used for signing administrator sessions
ADMIN_SESSION_SECRET="generate_a_random_32_byte_secret_for_admin_sessions"

# Pepper key (32+ characters) used for HMAC hashing of customer access keys before storage
LICENSE_PEPPER="generate_a_random_32_byte_secret_pepper_for_license_hashes"

# PRIVATE ADMINISTRATOR ROUTE SECRET
# Custom unpredictable URL slug to access the admin portal (never use /admin or /dashboard)
# Example URL: https://your-domain.com/x-shobdo-vault-8f92b7c4a1e3
ADMIN_ROUTE_SECRET="x-shobdo-vault-8f92b7c4a1e3"

# GEMINI_API_KEY (Existing AI Studio optional key)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="MY_APP_URL"
